# Copy to .env.local to override. All values are optional; defaults follow spec §9.
# Sizes are decimal megabytes (1 MB = 1,000,000 bytes).

# --- Feature flags ---
# Server-side processing is not part of this release; leave false.
VITE_ENABLE_SERVER_PROCESSING=false
# Opt in to the multithreaded ffmpeg.wasm core (needs cross-origin isolation). Off by default because the
# 0.12.10 multithreaded core hangs on most jobs; the app falls back to single-threaded if it crashes.
VITE_FFMPEG_MULTITHREAD=false

# --- Desktop limits ---
VITE_LIMIT_DESKTOP_IMAGE_MB=50
VITE_LIMIT_DESKTOP_IMAGE_MEGAPIXELS=100
VITE_LIMIT_DESKTOP_VIDEO_MB=500
VITE_LIMIT_DESKTOP_VIDEO_SECONDS=600
VITE_LIMIT_DESKTOP_VIDEO_MAX_EDGE=3840
VITE_LIMIT_DESKTOP_GIF_SECONDS=30
VITE_LIMIT_DESKTOP_BATCH_FILES=50
VITE_LIMIT_DESKTOP_ZIP_MB=1000
VITE_LIMIT_DESKTOP_CONCURRENT_IMAGE_JOBS=3

# --- Mobile limits (touch devices with small screens or <=4 GB memory) ---
VITE_LIMIT_MOBILE_IMAGE_MB=25
VITE_LIMIT_MOBILE_IMAGE_MEGAPIXELS=16.7
VITE_LIMIT_MOBILE_VIDEO_MB=200
VITE_LIMIT_MOBILE_VIDEO_SECONDS=180
VITE_LIMIT_MOBILE_VIDEO_MAX_EDGE=1920
VITE_LIMIT_MOBILE_GIF_SECONDS=15
VITE_LIMIT_MOBILE_BATCH_FILES=20
VITE_LIMIT_MOBILE_ZIP_MB=300
VITE_LIMIT_MOBILE_CONCURRENT_IMAGE_JOBS=1
